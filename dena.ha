# Config for hermes-opencode-web
# Generated: 2026-11-13

# App
APP_NAME = "hermes-opencode-web"
APP_ENV = "production"

# Theme
THEME = "lilac"
THEME_PRIMARY = "#9b7bb2"
THEME_LIGHT = "#d4c4ea"
THEME_BACKGROUND = "#f5f0ff"

# Features
LOGIN_ENABLED = true
REGISTER_ENABLED = true
SSH_AUTH = true
DOCKER_BUILD = true

# Docker
DOCKER_IMAGE = "hermes-opencode-web:login"
DOCKER_PORT = 80
